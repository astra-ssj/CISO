// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// 1. Core Users & Auth
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("VIEWER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
  
  // Relations
  authoredPolicies Policy[]
  managedRisks     RiskScenario[]
  incidents        Incident[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// -----------------------------------------------------------------------------
// 2. Risk Engine
// -----------------------------------------------------------------------------

model RiskScenario {
  id          String   @id @default(cuid())
  title       String   
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  status      String   @default("OPEN")
  
  // FAIR Analysis
  threatActor         String
  threatEventFreq     Float    
  vulnerability       Float    
  primaryLoss         Float    
  secondaryLoss       Float    
  controlsEffective   Float    
  
  // Computed
  ale                 Float    
  riskScore           Int      
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  history     RiskHistory[]
}

model RiskHistory {
  id              String       @id @default(cuid())
  riskScenarioId  String
  riskScenario    RiskScenario @relation(fields: [riskScenarioId], references: [id])
  date            DateTime     @default(now())
  score           Int
  ale             Float
}

// -----------------------------------------------------------------------------
// 3. Governance & Policy
// -----------------------------------------------------------------------------

model Policy {
  id            String   @id @default(cuid())
  title         String
  content       String   @default("")
  version       String   @default("1.0.0")
  status        String   @default("DRAFT")
  type          String?  // ISMS | PRIVACY | AI_GOV | ACCESS | INCIDENT
  owner         String?  // display owner name (optional; authorId is canonical)
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id])
  frameworks    String   @default("[]") // JSON
  controls      String   @default("[]") // JSON
  sections      String?  // JSON array of PolicySection
  mappings      String?  // JSON array of FrameworkMapping
  dependencies  String?  // JSON array of policy ids
  acknowledgment String? // JSON object
  changelog     String?  // JSON array
  lastUpdated   String?  // ISO string for display
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 4. Incidents & War Games
// -----------------------------------------------------------------------------

model Incident {
  id          String   @id @default(cuid())
  title       String
  severity    String
  status      String
  commanderId String
  commander   User     @relation(fields: [commanderId], references: [id])
  
  startedAt   DateTime @default(now())
  resolvedAt  DateTime?
  
  events      IncidentEvent[]
}

model IncidentEvent {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  type        String   
  payload     String   // JSON string
  timestamp   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 5. Vendors (simple list — risk page)
// -----------------------------------------------------------------------------

model Vendor {
  id                  String   @id @default(cuid())
  name                String
  serviceDescription  String
  tier                String   // TIER_1_CRITICAL | TIER_2_HIGH | TIER_3_MEDIUM | TIER_4_LOW
  status              String   // ACTIVE | PENDING_ASSESSMENT | REJECTED | DEPRECATED
  lastAssessmentDate  String
  inherentRiskScore   Int
  contactEmail        String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 6. Vendor Risk (rich assessments — vendors page)
// -----------------------------------------------------------------------------

model VendorRisk {
  id                     String   @id @default(cuid())
  name                   String
  category               String
  description            String
  status                 String
  riskTier               String
  riskScore              Int
  dataAccess             String   // JSON array
  complianceCertifications String // JSON array
  contractExpiry         String
  lastAssessment         String
  contactName            String
  contactEmail           String
  notes                  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  assessmentHistory      VendorAssessment[]
}

model VendorAssessment {
  id          String     @id @default(cuid())
  vendorRiskId String
  vendorRisk  VendorRisk @relation(fields: [vendorRiskId], references: [id], onDelete: Cascade)
  date        String
  score       Int
  findings    String     // JSON array
  assessor    String
  createdAt   DateTime   @default(now())
}

// -----------------------------------------------------------------------------
// 7. Evidence (governance vault)
// -----------------------------------------------------------------------------

model Evidence {
  id          String   @id @default(cuid())
  name        String
  type        String
  fileName    String
  fileSize    Int
  controlIds  String   // JSON array
  framework   String
  status      String
  uploadDate  String
  expiryDate  String?
  uploadedBy  String
  notes       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 8. OKR & Projects (strategy)
// -----------------------------------------------------------------------------

model Objective {
  id           String   @id @default(cuid())
  title        String
  description  String
  quarter      String
  year         Int
  owner        String
  status       String
  keyResults   String   // JSON array of KeyResult
  linkedRisks  String?  // JSON array of risk ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  title            String
  description      String
  owner            String
  status           String
  priority         String
  budgetAllocated  Int
  budgetSpent      Int
  linkedObjectives String   // JSON array
  linkedRisks      String   // JSON array
  startDate        String
  targetEndDate    String
  tags             String   // JSON array
  phases           String   // JSON array of ProjectPhase
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 9. Notifications & Alert Rules
// -----------------------------------------------------------------------------

model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  severity   String
  read       Boolean  @default(false)
  timestamp  Int      // Unix ms
  actionUrl  String?
  createdAt  DateTime @default(now())
}

model AlertRule {
  id                String   @id @default(cuid())
  name              String
  condition         String
  threshold         Float
  enabled           Boolean  @default(true)
  notificationType  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 10. Playbooks (incident response)
// -----------------------------------------------------------------------------

model Playbook {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String
  status      String   @default("READY")
  phases      String   // JSON array of PlaybookPhase
  startTime   Int?     // Unix ms
  endTime     Int?
  evidenceLog String   // JSON array of { timestamp, message }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 11. Immutable audit fabric (append-only; never update or delete)
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actor      String   // userId or 'SYSTEM'
  action     String   // event type
  resource   String   // e.g. 'caiq:AIS-01.1'
  resourceId String?
  metadata   String?  // JSON
}

// -----------------------------------------------------------------------------
// 12. Organizational Knowledge Repository
// -----------------------------------------------------------------------------

model KnowledgeEntry {
  id                 String    @id @default(cuid())
  questionText       String
  questionNormalized String    // lowercase, cleaned for matching
  keywords           String    // comma-separated for search
  domain             String    // AIS, IAM, DSP, CUSTOM, etc.
  category           String    // Access Control, Encryption, Incident Response, etc.
  answerType         String    // YES, NO, NA, CONDITIONAL
  answerText         String    // The approved answer
  evidence           String?   // Evidence references
  frameworks         String?   // JSON: [{framework, controlId}]
  source             String    // Which assessment this came from
  approvedBy         String?   // Who approved this answer
  approvedAt         DateTime?
  confidence         Float     @default(1.0)
  usageCount         Int       @default(0) // How many times reused
  lastUsed           DateTime?
  jurisdiction       String?   // EU, US, UK, etc.
  tags               String?   // comma-separated custom tags
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
