# ═══════════════════════════════════════════════════════════════════════
# Astra-CISO v3.0 — Environment Variables (decision-loop)
# ═══════════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# Postgres: docker compose up -d postgres

# ── Core ──────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://astra:astra@localhost:5432/astra"
# If host 5432 is taken, map another port: ASTRA_PG_PORT=5433 docker compose up -d postgres
# and set DATABASE_URL=postgresql://astra:astra@localhost:5433/astra
# Random secret — generate with: openssl rand -base64 32
# Auth.js v5 requires AUTH_SECRET; NEXTAUTH_SECRET is kept for compatibility.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OpenNeko sidecar (do not npm-install OpenNeko into this app)
# Shared secret for POST /api/internal/* (watchers, approvals, skill catalog)
ASTRA_INTERNAL_SECRET=
# OpenNeko web UI — Decision Center / Command Center CTA when set
OPENNEKO_URL=
# Optional dual-write of approvals into OpenNeko memory
OPENNEKO_MEMORY_URL=

# Demo credentials (change in production!)
# Email login works without Google OAuth:
#   ciso@astra.ai / admin123
#   analyst@astra.ai / user123

# ── Google Workspace SSO (optional) ───────────────────────────────────
# Leave unset to use email/password only. Google is never required.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── AI Providers (configure at least one) ─────────────────────────────

AI_PROVIDER=MOCK          # ANTHROPIC | GOOGLE | MOCK

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-2.0-flash

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Threat Intelligence (all optional, all free) ─────────────────────

# Shodan — attack surface, enrichment, vendor scanning
# Free account: https://account.shodan.io
# SHODAN_API_KEY=

# AlienVault OTX — 100k+ IOCs, community pulses
# Free account: https://otx.alienvault.com
# ALIENVAULT_OTX_KEY=

# Abuse.ch feeds — ThreatFox, URLhaus, MalwareBazaar (no key needed)
ABUSECH_ENABLED=true

# USGS Earthquake data — BCDR monitoring (no key needed)
USGS_ENABLED=true

# GDELT News Intelligence — global events, geolocation (no key needed)
GDELT_ENABLED=true

# ── Intelligence (optional, for advanced features) ───────────────────

# OpenSky Network — military flight tracking
# Free account: https://opensky-network.org
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# VesselFinder — naval vessel tracking
# VESSELFINDER_API_KEY=

# NASA FIRMS — satellite fire detection
# NASA_FIRMS_API_KEY=

# Groq AI — threat classification (Llama 3.1)
# GROQ_API_KEY=

# ── Caching (optional) ──────────────────────────────────────────────

# Upstash Redis — cross-request caching
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Jira Integration (optional) ─────────────────────────────────────

# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SEC
