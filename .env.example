# Astra CISO — local/community configuration
# Copy to .env for Docker Compose:
#   cp .env.example .env
#
# Defaults are intentionally safe for localhost evaluation. Change secrets before
# exposing Astra beyond your own machine.

# Application
NODE_ENV=development
ASTRA_MODE=standard
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Database
POSTGRES_PASSWORD=astra_local
DATABASE_URL=postgresql://astra:astra_local@localhost:5432/astra
ASTRA_PG_PORT=5432

# Authentication
# Generate for shared deployments: openssl rand -base64 32
AUTH_SECRET=local-only-change-before-shared-use
NEXTAUTH_SECRET=local-only-change-before-shared-use
AUTH_SIGNUP_MODE=INVITE_ONLY
ALLOWED_EMAIL_DOMAINS=

# Integration credential encryption
# Kept separate from AUTH_SECRET so auth-secret rotation does not invalidate stored connectors.
# Generate for shared deployments: openssl rand -hex 32
ASTRA_ENCRYPTION_KEY=local-only-change-before-shared-use

# Evidence storage
EVIDENCE_STORAGE_PATH=./data/evidence

# AI — optional. Supported values today: NONE | ANTHROPIC | GOOGLE
AI_PROVIDER=NONE
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal sidecar/service authentication
ASTRA_INTERNAL_SECRET=
OPENNEKO_URL=
OPENNEKO_MEMORY_URL=

# Optional threat intelligence
SHODAN_API_KEY=
ALIENVAULT_OTX_KEY=
ABUSECH_ENABLED=false
USGS_ENABLED=false
GDELT_ENABLED=false

# Optional caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Jira integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
